<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Hub2gether - Project Showcase</title>
<!-- Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<!-- Icons -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
tailwind.config = {
  darkMode: "class",
  theme: {
    extend: {
      colors: {
        primary: "#63E6BE",
        "primary-dark": "#4fd1a9",
        secondary: "#5C6B73",
        background: "#F8FAFB",
        surface: "#FFFFFF",
        "surface-variant": "#F1F5F9",
        "on-surface": "#1E293B",
        outline: "#E2E8F0"
      },
      fontFamily: {
        headline: ["Inter", "sans-serif"],
        body: ["Inter", "sans-serif"]
      },
      borderRadius: {
        DEFAULT: "0.5rem",
        lg: "1rem",
        xl: "1.5rem",
        "2xl": "2rem",
        full: "9999px"
      },
      boxShadow: {
        'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
        'card': '0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 4px 6px -2px rgba(0, 0, 0, 0.05)'
      }
    }
  }
};
</script>
<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
  }
  .asymmetric-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
  }
  body {
    background-color: #F8FAFB;
  }
</style>
</head>
<body class="font-body text-on-surface antialiased">
<nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100">
<div class="flex justify-between items-center w-full px-8 py-4 max-w-7xl mx-auto">
<div class="text-2xl font-black tracking-tight text-slate-800 font-headline flex items-center gap-2">
<div class="w-8 h-8 bg-primary rounded-lg"></div>
      Hub2gether
    </div>
<div class="hidden md:flex items-center gap-8">
<a class="text-primary font-bold border-b-2 border-primary px-1 py-1 transition-all" href="#">Vitrine</a>
<a class="text-slate-500 font-medium hover:text-primary transition-colors" href="#">Fonctionnalités</a>
<a class="text-slate-500 font-medium hover:text-primary transition-colors" href="#">Communauté</a>
<a class="text-slate-500 font-medium hover:text-primary transition-colors" href="#">Tarifs</a>
</div>
<div class="flex items-center gap-4">
<div class="hidden sm:flex bg-slate-100 rounded-full px-4 py-2 items-center gap-2 group border border-transparent focus-within:border-primary/30 transition-all">
<span class="material-symbols-outlined text-slate-400">search</span>
<input class="bg-transparent border-none focus:ring-0 text-sm w-32 focus:w-48 transition-all" placeholder="Recherche rapide..." type="text"/>
</div>
<button class="bg-slate-900 text-white px-6 py-2.5 rounded-full font-bold hover:bg-slate-800 transition-all">Commencer</button>
</div>
</div>
</nav>
<main class="max-w-7xl mx-auto px-8 py-10">
<header class="mb-10">
<h1 class="font-headline text-4xl font-extrabold text-slate-900 tracking-tight mb-2">Présentation du Projet</h1>
<p class="text-slate-500 text-lg font-medium">Hub2gether Core • Le hub social et sportif haute performance</p>
</header>
<div class="asymmetric-grid">
<div class="col-span-12 lg:col-span-8 bg-white rounded-3xl p-8 shadow-card border border-slate-50 relative overflow-hidden group">
<div class="relative z-10 flex flex-col md:flex-row gap-10 items-center">
<div class="w-full md:w-1/2">
<span class="inline-block px-3 py-1 bg-primary/20 text-slate-700 rounded-full text-[10px] font-bold uppercase tracking-widest mb-6">MATCHMAKING EN DIRECT</span>
<h2 class="font-headline text-3xl font-extrabold mb-4 leading-tight text-slate-900">Match de Padel aujourd'hui</h2>
<div class="flex items-center gap-4 mb-8">
<div class="flex -space-x-2">
<div class="w-10 h-10 rounded-full border-2 border-white bg-slate-300"></div>
<div class="w-10 h-10 rounded-full border-2 border-white bg-slate-400"></div>
<div class="w-10 h-10 rounded-full border-2 border-white bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-500 shadow-sm">+1</div>
</div>
<span class="text-sm text-slate-500 font-medium">Rejoint par Alex et Sarah</span>
</div>
<div class="grid grid-cols-2 gap-4 mb-8">
<div class="p-4 bg-slate-50/80 rounded-2xl border border-slate-100">
<p class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mb-1">Niveau</p>
<p class="font-headline text-lg font-bold text-slate-800">Compétitif (4.5)</p>
</div>
<div class="p-4 bg-slate-50/80 rounded-2xl border border-slate-100">
<p class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mb-1">Places restantes</p>
<p class="font-headline text-lg font-bold text-primary-dark">1 Place</p>
</div>
</div>
<button class="w-full py-4 bg-primary text-slate-900 rounded-2xl font-bold hover:shadow-lg hover:shadow-primary/30 transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined">sports_tennis</span> Réserver ma place
</button>
</div>
<div class="w-full md:w-1/2 rounded-3xl overflow-hidden border border-slate-100 transform rotate-1 group-hover:rotate-0 transition-transform duration-500 shadow-xl hover:shadow-2xl transition-shadow">
<div class="w-full h-64 object-cover bg-slate-200"></div>
<div class="p-5 bg-white border-t border-slate-50">
<div class="flex justify-between items-center">
<div>
<p class="font-bold text-slate-900">Green Arena Hub</p>
<p class="text-xs text-slate-500 font-medium">18:00 • Paris, FR</p>
</div>
<div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center">
<span class="material-symbols-outlined text-primary-dark text-lg" style="font-variation-settings: 'FILL' 1;">verified</span>
</div>
</div>
</div>
</div>
</div>
</div>
<div class="col-span-12 lg:col-span-4 bg-white rounded-3xl p-8 shadow-card border border-slate-50 flex flex-col">
<div class="flex justify-between items-start mb-8">
<h3 class="font-headline text-lg font-bold text-slate-800">Performance</h3>
<span class="px-2.5 py-1 bg-slate-900 text-white text-[10px] font-bold rounded-md">TOP 5%</span>
</div>
<div class="mb-10">
<div class="flex items-baseline gap-1">
<span class="text-5xl font-black text-slate-900 tracking-tight">8.4</span>
<span class="text-lg text-slate-400 font-bold">/10</span>
</div>
<p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-2">NOTE GLOBALE DU JOUEUR</p>
</div>
</div>
</div>
<footer class="mt-16 text-center border-t border-slate-100 pt-10">
<p class="text-slate-400 text-[10px] font-bold tracking-widest uppercase">CONÇU POUR HUB2GETHER © 2024 • BOOSTER LES COMMUNAUTÉS SPORTIVES</p>
</footer>
</main>
</body></html>
