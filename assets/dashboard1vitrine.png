</div>
</div>
<!-- Rank 2 -->
<div class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors rounded-2xl border border-transparent">
<div class="w-8 h-8 font-bold text-slate-300 italic text-xl flex items-center justify-center">02</div>
<img class="w-11 h-11 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDJs0o_AVcDLK8eKQrsd_VmYbLv_KL0FkanXvyUpTanXxCgfM6OIsLzkiTL-nI4Qwz3e-Fk9iuGpbwAXq120VqRgulh5giqVBfG8UTxUhEVvzvX24BeOFL02MaFk0x3_pzrcEcsO9vSf_CgsofsWN-cqtvsvbyRDAtQi7y2M2lSdu_lIaIpsfp5lmUMD9sbcKtYnj_6t7nxz5B97vCeZK2RXwspha9iFCSCOwsVHqZmqNLIm5bfXpii4W1DPe3V5EGmFDEgVQERHn0A"/>
<div class="flex-1">
