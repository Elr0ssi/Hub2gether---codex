<h3 class="font-headline text-lg font-bold text-slate-900">TOP JOUEURS</h3>
<span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Saison #04</span>
</div>
<div class="space-y-4">
<!-- Rank 1 -->
<div class="flex items-center gap-4 p-4 bg-primary/5 rounded-2xl border border-primary/10">
<div class="w-8 h-8 font-black text-primary-dark italic text-xl flex items-center justify-center">01</div>
<img class="w-11 h-11 rounded-full object-cover shadow-sm" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDJ7GcGse3G5X074HSwY7OM9h04x5iDKK8ErNJ5OrUEvnshZX0raIlHL9-CXOo56zXyjhZQvc1k5anbdXvRLuwWVKUkDysvnIXbfC7Nqozz6AxxEzDBMfCU3iY8WUYZgt_7uX_HPhsOcBEXGZ7tcPqoSmwBYXm3gSOpAHxJ71qe96bngTHmSTVCXKpY8_VHrQkVPPPLG65_BmFPTSUxFr_kKSvPoUyboRzcJNg1ZChdstFsMw2BYSwsox2d8ueltkMxlquBQCVt_m-y"/>
