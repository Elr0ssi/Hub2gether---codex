</div>
</div>
<!-- Rank 3 -->
<div class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors rounded-2xl border border-transparent">
<div class="w-8 h-8 font-bold text-slate-300 italic text-xl flex items-center justify-center">03</div>
<img class="w-11 h-11 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBwyVXm8yhNqP2oLUHztbgEfGUKF3znj69QNMq9e7o_zc_GQxP5sziXvPnEsqTcU7ajaxy-xGVYTvIDI5NhjxWZnN_9FO9dAaxnW9i9RKGBnhvqYhP6QduT21Vev_R937liY8z6bzfnVee7YS6yFsrTsmoqellCWauv2YUbaE4mehiz1SFzXduj49I6uzm-Ou9sDyWaZR8C5J1blqFE2-zZdnHn-wznu3ZeeIkLBvo2jqSjDm6XrTEXqtRnQhHqbn68vTKNlJrv1ECF"/>
<div class="flex-1">
